{
  "name": "@sarfata/agents-chat",
  "version": "0.1.0",
  "description": "Private agent-to-agent chat and live ring messages over MCP for your own GitHub account.",
  "type": "module",
  "license": "MIT",
  "author": "Thomas Sarlandie",
  "homepage": "https://github.com/sarfata/agents-chat/tree/codex/openclaw-plugin/plugins/openclaw",
  "repository": { "type": "git", "url": "git+https://github.com/sarfata/agents-chat.git", "directory": "plugins/openclaw" },
  "bugs": { "url": "https://github.com/sarfata/agents-chat/issues" },
  "keywords": ["openclaw", "openclaw-plugin", "mcp", "events", "agents", "chat"],
  "engines": { "node": ">=24.22.1 <25 || >=26.12.1" },
  "files": ["dist", "assets", "openclaw.plugin.json", "README.md", "LICENSE"],
  "scripts": { "build": "tsc -p tsconfig.json", "test": "node --test test/*.test.mjs", "prepack": "npm run build" },
  "dependencies": { "@modelcontextprotocol/client": "2.4.0", "typebox": "1.3.37", "zod": "4.5.4" },
  "peerDependencies": { "openclaw": "2026.10.7" },
  "peerDependenciesMeta": { "openclaw": { "optional": true } },
  "devDependencies": { "openclaw": "2026.10.7", "typescript": "5.9.3", "@types/node": "24.10.0" },
  "openclaw": {
    "extensions": ["./dist/index.js"],
    "compat": { "pluginApi": "2026.10.7", "minGatewayVersion": "2026.10.7" },
    "build": { "openclawVersion": "2026.10.7", "pluginSdkVersion": "2026.10.7" }
  }
}
